<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fondo_principal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_perfil_paciente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="35dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Consulta del paciente"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Perfil del paciente -->
    <LinearLayout
        android:id="@+id/displays_fijos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingBottom="15dp"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/header_perfil_paciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/card_background_azul_paciente">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:text="MG"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                app:layout_constraintStart_toEndOf="@id/tvAvatarInitials"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvNombrePaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="María González"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvInfoPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="45 años | F | O+"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Contenido scrolleable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/displays_fijos"
        app:layout_constraintBottom_toTopOf="@id/btnEditarConsulta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- INFORMACIÓN DE CONSULTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Información de consulta"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_info_consulta"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Fecha" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                        <TextView android:id="@+id/tvFechaConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Hora" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                        <TextView android:id="@+id/tvHoraConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Motivo de visita" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvMotivoConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="" android:textColor="#1A1A1A" android:textSize="14sp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Síntomas" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvSintomasConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Diagnóstico" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvDiagnosticoConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Notas del médico" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvNotasConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Indicaciones" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvIndicacionesConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                    android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Receta" android:textSize="14sp" android:textColor="@color/texto_ver_consulta"/>
                <TextView android:id="@+id/tvRecetaConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="14sp" android:textColor="#1A1A1A"/>
            </LinearLayout>

            <!-- EXPLORACIÓN FÍSICA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exploración Física"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/fondo_info_datos_antropometricos"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Altura" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvAlturaConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Peso" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvPesoConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="IMC" android:textSize="14sp" android:textColor="#B49A45"/>
                <TextView android:id="@+id/tvIMCConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="—"
                    android:textColor="#1A1A1A" android:textSize="14sp" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Presión (mmHg)" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvPresionConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="FC (lpm)" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvFCConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Temp (°C)" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvTempConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SpO₂ (%)" android:textSize="14sp" android:textColor="#B49A45"/>
                        <TextView android:id="@+id/tvSpOConsulta" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#1A1A1A"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Frec. Respiratoria (rpm)" android:textSize="14sp" android:textColor="#B49A45"/>
                <TextView android:id="@+id/tvFrecRespiratoriaConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="#1A1A1A" android:textSize="14sp" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Observaciones Físicas" android:textSize="14sp" android:textColor="#B49A45"/>
                <TextView android:id="@+id/tvObservacionesFisicasConsulta" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textColor="#1A1A1A" android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón Editar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarConsulta"
        style="@style/ButtonSecondary"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="Editar Consulta"
        android:textSize="16dp"
        android:textAllCaps="false"
        android:elevation="10dp"
        app:backgroundTint="@null"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
