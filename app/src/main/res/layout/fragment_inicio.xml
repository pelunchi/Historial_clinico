<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fondo_principal">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#D6F8EC"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido"
            android:textColor="#6B7280"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/doctor_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Juan Pérez"
            android:textColor="#1F2937"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Stats cards -->
    <LinearLayout
        android:id="@+id/resumenCartas"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:layout_margin="20dp"

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"

        android:paddingTop="25dp"

        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:background="@drawable/card_background_azul_inicio"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultas hoy"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvConsultasHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/text_blue"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:background="@drawable/card_background_lila_inicio"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total pacientes"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:id="@+id/tvTotalPacientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/text_purple"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"

        android:clipToPadding="false"
        android:clipChildren="false"

        app:layout_constraintTop_toBottomOf="@id/ultimasConsultasTitulo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="2dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Patient list container (populated from DB) -->
            <LinearLayout
                android:id="@+id/llUltimasConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <!-- Search bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:translationY="-40dp"

        app:cardCornerRadius="12dp"
        app:cardElevation="7dp"
        app:cardUseCompatPadding="true"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Buscar paciente..."
                android:inputType="text"
                android:paddingStart="10dp"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Últimas consultas title -->
    <TextView
        android:id="@+id/ultimasConsultasTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Últimas consultas"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"

        android:paddingBottom="5dp"

        app:layout_constraintTop_toBottomOf="@id/resumenCartas"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- Button Nuevo Paciente -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevoPaciente"
        style="@style/ButtonPrimary"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="+  Nuevo paciente"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:elevation="10dp"
        app:backgroundTint="@null"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>