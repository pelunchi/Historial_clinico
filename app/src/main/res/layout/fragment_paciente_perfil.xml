<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/fondo_principal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_perfil_paciente"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="35dp"
        android:paddingBottom="8dp"
        android:background="#FFFFFF"

        android:elevation="4dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil del paciente"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Perfil -->
    <LinearLayout
        android:id="@+id/displays_fijos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingBottom="3dp"

        android:elevation="4dp"

        app:layout_constraintTop_toBottomOf="@id/header_perfil_paciente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Avatar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"

            android:background="@drawable/card_background_azul_paciente">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:text=""
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"

                app:layout_constraintStart_toEndOf="@id/tvAvatarInitials"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvNombrePaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvInfoPaciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnExpediente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expediente"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:backgroundTint="#1D9E75"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

            <Button
                android:id="@+id/btnConsultas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Consultas"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:backgroundTint="#E8F5E9"
                android:textColor="#2E7D32"
                android:layout_marginStart="4dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"

        android:clipToPadding="false"
        android:clipChildren="false"

        app:layout_constraintTop_toBottomOf="@id/displays_fijos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONTENEDOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ======= EXPEDIENTE ======= -->
            <LinearLayout
                android:id="@+id/layoutExpediente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingHorizontal="20dp"
                android:paddingBottom="100dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información de contacto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="8dp"/>

                <!-- Contenedor Información de contacto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_info_personal"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <!-- Telefono -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="No hay un número registrado"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No hay un email registrado"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="8dp"/>

                    <!-- Fecha de nacimiento -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de nacimiento"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvFechaNacimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DD/MM/AAAA"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:layout_marginBottom="8dp"/>

                    <!-- CURP -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURP"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <TextView
                        android:id="@+id/tvCURP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin registrar"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos antropométricos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="8dp"/>

                <!-- Contenedor Datos Antropométricos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_info_datos_antropometricos"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <!-- Altura -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Altura  "
                                android:textSize="14sp"
                                android:textColor="#B49A45"/>

                            <TextView
                                android:id="@+id/tvAltura"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Sin medir aún"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"/>

                        </LinearLayout>

                        <!-- Peso -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Peso"
                                android:textSize="14sp"
                                android:textColor="#B49A45" />

                            <TextView
                                android:id="@+id/tvPeso"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:text="Sin pesar aún"
                                android:textSize="14sp"
                                android:textColor="#1A1A1A"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- IMC -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMC"
                        android:textSize="14sp"
                        android:textColor="#B49A45" />

                    <TextView
                        android:id="@+id/tvIMC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="S/N"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Antecedentes Médicos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginBottom="8dp"/>

                <!-- Contenedor Antecedentes Medicos-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/fondo_info_antecedentes_medicos"
                    android:padding="12dp"
                    android:layout_marginBottom="24dp">

                    <!-- Antecedentes heredofamiliares -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Antecedentes heredofamiliares"
                        android:textSize="14sp"
                        android:textColor="#C8793D" />

                    <TextView
                        android:id="@+id/tvAntecedentesHeredofamiliares"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Ninguno"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Cirugias previas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cirugias previas"
                        android:textSize="14sp"
                        android:textColor="#C8793D" />

                    <TextView
                        android:id="@+id/tvCirugiasPrevias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Ninguna"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Alergias -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alergias"
                        android:textSize="14sp"
                        android:textColor="#C8793D" />

                    <TextView
                        android:id="@+id/tvAlergias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Ninguna"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Enfermedades crónicas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enfermedades crónicas"
                        android:textSize="14sp"
                        android:textColor="#C8793D" />

                    <TextView
                        android:id="@+id/tvEnfermedadesCronicas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Ninguna"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Hospitalizaciones previas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hospitalizaciones previas"
                        android:textSize="14sp"
                        android:textColor="#C8793D" />

                    <TextView
                        android:id="@+id/tvHospitalizacionesPrevias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Ninguna"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp" />

                    <!-- Otros... -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Otros"
                        android:textColor="#C8793D"
                        android:visibility="visible"/>

                    <TextView
                        android:id="@+id/tvOtrosAntecedentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin información"
                        android:lineSpacingExtra="2dp"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"/>

                </LinearLayout>
            </LinearLayout>

            <!-- ===================== CONSULTAS ===================== -->
            <LinearLayout
                android:id="@+id/layoutConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConsultas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="50dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:nestedScrollingEnabled="false"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Button Editar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarExpediente"
        style="@style/ButtonSecondary"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:text="Editar Expediente"
        android:textSize="16dp"
        android:textAllCaps="false"
        android:elevation="10dp"
        app:backgroundTint="@null"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button Nuevo Paciente -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaConsulta"
        style="@style/ButtonPrimary"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:text="+  Nueva consulta"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:elevation="10dp"
        app:backgroundTint="@null"
        android:visibility="gone"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>