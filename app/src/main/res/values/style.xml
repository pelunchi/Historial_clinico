<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonPrimary">
        <item name="android:background">@drawable/button_verde_primario</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ButtonSecondary">
        <item name="android:background">@drawable/button_editar</item>
        <item name="android:textColor">#1D9E75</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CustomInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <!-- Fondo -->
        <item name="boxBackgroundColor">@color/fondo_gris_claro</item>
        <!-- Borde dinámico -->
        <item name="boxStrokeColor">@color/stroke_input</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <!-- Borde redondeado -->
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <!-- Texto -->
        <item name="hintTextColor">@color/texto_formulario_claro</item>
    </style>

    <style name="CustomDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <!-- Fondo -->
        <item name="boxBackgroundColor">@color/fondo_gris_claro</item>
        <!-- Borde -->
        <item name="boxStrokeColor">@color/stroke_input</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <!-- Bordes -->
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <!-- Hint -->
        <item name="hintTextColor">@color/texto_formulario_claro</item>
        <!-- Icono dropdown -->
        <item name="endIconTint">@color/borde_formulario_oscuro</item>
    </style>

    <!-- Botom IMC -->
    <style name="CustomInput.IMC" parent="CustomInput">
        <!-- Fondo diferente -->
        <item name="boxBackgroundColor">@color/fondo_section_da</item>
        <!-- Borde diferente -->
        <item name="boxStrokeColor">@color/stroke_imc</item>
    </style>

    <!-- Botones Fecha y Hora de Consulta -->
    <style name="CustomInput.FichaUnclickeable" parent="CustomInput">
        <!-- Fondo diferente -->
        <item name="boxBackgroundColor">@color/fondo_section_ficha</item>
        <!-- Borde diferente -->
        <item name="boxStrokeColor">@color/stroke_ficha_unclickeable</item>

    </style>

